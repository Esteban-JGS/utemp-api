# Copy this file to .env and replace every value. Never commit .env.

# PostgreSQL
POSTGRES_DB=utemp
POSTGRES_USER=utemp
POSTGRES_PASSWORD=change-me

# pgAdmin (optional, only started with: docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Mail (SMTP). Use an app password, never the account password.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-account@example.com
SPRING_MAIL_PASSWORD=your-app-password

# JWT. Must be at least 32 bytes (256 bits). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Milliseconds: 15 minutes / 7 days
JWT_EXPIRATION_ACCESS=900000
JWT_EXPIRATION_REFRESH=604800000

# Largest file a student can upload (optional, default 20MB)
# FILE_MAX_SIZE=20MB
